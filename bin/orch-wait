#!/bin/bash
# Block until a terminal goes quiet after you sent it something (or the max wait passes).
# Usage: orch-wait <label|sid-prefix> [max-seconds=90]
# Prints "idle" or "still-busy (timeout)". Then run orch-read.

source "$(dirname "$0")/_lib.sh"
TARGET="${1:?Usage: orch-wait <label|sid-prefix> [max-seconds]}"
MAX="${2:-90}"
s=$(orch_resolve "$TARGET") || exit 1
sid=$(jq -r .sid <<<"$s")

# Fingerprint of "what the agent has produced": transcript size if there is one, else the cleaned screen text.
snap() {
  local tr; tr=$(orch_transcript "$sid")
  if [[ -n "$tr" ]]; then stat -f %z "$tr"
  else orch_sessions 600 | jq -r --arg sid "$sid" '.[] | select(.sid == $sid) | .bufferTail' | orch_strip_ansi \
        | grep -v -E '(thinking|esc to interrupt|\([0-9]+s ·)' | tr -d '✻✽✶✳✢· ' | md5; fi
}

start=$(date +%s); last=$(snap); stable=0; active=0
while (( $(date +%s) - start < MAX )); do
  sleep 1; cur=$(snap)
  if [[ "$cur" == "$last" ]]; then stable=$((stable+1)); else stable=0; active=1; last="$cur"; fi
  # Allow ~20s for the agent to start before concluding nothing is happening.
  (( active == 1 && stable >= 6 )) && { echo idle; exit 0; }
  (( active == 0 && stable >= 20 )) && { echo "idle (no activity seen)"; exit 0; }
done
echo "still-busy (timeout after ${MAX}s)"
