#!/bin/bash
# Read the recent screen output of a live terminal.
# Usage: orch-read <label|sid-prefix> [chars=3000]
# Reads the bridge's live buffer (works for any engine), ANSI-stripped.
# Look at the END of the output: that is the current state (spinner lines mean still working,
# a prompt box with nothing after it means idle/finished).

set -e
BRIDGE_URL="${BRIDGE_URL:-http://localhost:3002}"
TARGET="${1:?Usage: orch-read <label|sid-prefix> [chars]}"
CHARS="${2:-3000}"

curl -sf "$BRIDGE_URL/terminals?tail=$CHARS" | jq -r --arg t "$TARGET" '
  [.sessions[] | select(.label == $t or .agent == $t or (.sid | startswith($t)))] as $m
  | if ($m | length) == 0 then "NOT FOUND: \($t)" | halt_error(1)
    elif ($m | length) > 1 then "AMBIGUOUS: \($t) matches \($m | map("\(.label) (\(.sid[0:8]))") | join(", "))" | halt_error(2)
    else $m[0] | "== \(.label) (\(.sid[0:8])) ==\n\(.bufferTail)" end'
