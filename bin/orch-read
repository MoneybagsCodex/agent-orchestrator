#!/bin/bash
# Read what a terminal's agent has said/done recently.
# Usage: orch-read <label|sid-prefix> [entries=8]
# Uses the agent's conversation transcript when one exists (clean, complete); otherwise falls back to the live screen text.

source "$(dirname "$0")/_lib.sh"
TARGET="${1:?Usage: orch-read <label|sid-prefix> [entries]}"
N="${2:-8}"
s=$(orch_resolve "$TARGET") || exit 1
sid=$(jq -r .sid <<<"$s"); label=$(jq -r .label <<<"$s")
tr=$(orch_transcript "$sid")

if [[ -n "$tr" ]]; then
  age=$(orch_age "$tr")
  echo "== $label (${sid:0:8}) — $( (( age < 10 )) && echo "WORKING (activity ${age}s ago)" || echo "idle for ${age}s") =="
  jq -r 'select((.type == "user" or .type == "assistant") and (.isSidechain | not))
    | (.message.content | if type == "string" then .
        else map(if .type == "text" then .text
                 elif .type == "tool_use" then "[tool: \(.name) \((.input.command // .input.file_path // .input.pattern // "") | tostring | .[0:80])]"
                 else empty end) | join("\n") end) as $t
    | select($t != "") | "\(.type | ascii_upcase): \($t | .[0:1500])"' "$tr" | tail -n "$N"
else
  echo "== $label (${sid:0:8}) — no transcript yet; live screen text (may be short/noisy) =="
  jq -r .bufferTail <<<"$s" | orch_strip_ansi | grep -E '[A-Za-z0-9]' | tail -20
fi
