#!/bin/bash
# Read what a terminal's agent has said/done recently.
# Usage: orch-read <label|sid-prefix> [entries=8]
# Uses the agent's conversation transcript when one exists (clean, complete); otherwise falls back to the live screen text.

source "$(dirname "$0")/_lib.sh"
TARGET="${1:?Usage: orch-read <label|sid-prefix> [entries]}"
N="${2:-8}"
s=$(orch_resolve "$TARGET") || exit 1
sid=$(jq -r .sid <<<"$s"); label=$(jq -r .label <<<"$s")
pid=$(jq -r .pid <<<"$s")
tr=$(orch_transcript "$sid" "$pid")
status=$(orch_status "$pid")

# If the agent is blocked on a prompt, show what is on screen first: that is what the user must decide.
prompt=$(jq -r .bufferTail <<<"$s" | orch_strip_ansi | grep -E "Esc to cancel|Enter to confirm|Tab to amend|Do you want to|don.t ask again|\(y/n\)" | tr -s ' ' | cut -c1-200)
if [[ "$status" == waiting* || -n "$prompt" ]]; then
  echo "!! PENDING PROMPT on '$label' (agent status: ${status:-unknown}). Text visible on its screen (only the last ~200 characters can be seen):"
  echo "$prompt"
  echo "!! Do not type text at it. Ask the user whether to approve; answer with orch-send --key."
  echo
fi

if [[ -n "$tr" ]]; then
  age=$(orch_age "$tr")
  echo "== $label (${sid:0:8}) — agent reports: ${status:-unknown}; last transcript write ${age}s ago =="
  jq -r '
    def txt: .message.content | if type == "string" then . else map(
        if .type == "text" then .text
        elif .type == "tool_use" then "[tool: \(.name) \((.input.command // .input.file_path // .input.pattern // "") | tostring | .[0:80])]"
        else empty end) | join("\n") end;
    if (.type == "user" or .type == "assistant") and (.isSidechain | not) then
      (txt) as $t | select($t != "") | "\(.type | ascii_upcase): \($t | .[0:1500])"
    elif .type == "system" and (.subtype == "local_command" or .subtype == "informational") then
      ((.content // "") | tostring | gsub("<[^>]+>"; " ") | gsub("\\s+"; " ") | .[0:300]) as $c
      | select($c | test("\\S")) | "SYSTEM: \($c)"
    else empty end' "$tr" | tail -n "$N"
else
  echo "== $label (${sid:0:8}) — no transcript yet; live screen text (may be short/noisy) =="
  jq -r .bufferTail <<<"$s" | orch_strip_ansi | grep -E '[A-Za-z0-9]' | tail -20
fi
